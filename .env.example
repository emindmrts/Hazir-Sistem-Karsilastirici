# Kopyala:  copy .env.example .env   (Windows)  /  cp .env.example .env  (Linux/Mac)
# Gercek secret'lari ASLA commitleme — .env git'te takip edilmez.

# Google Indexing (opsiyonel, su an kullanilmiyor)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# EnUcuzSistem API scraper'i kullan (true/false).
# false ise tek tek magaza scraper'lari calisir.
USE_ENUCUZSISTEM_API=true

# MySQL — filter-data /api/cpu + /api/gpu icin gerekli.
# Uretimde (Railway) bu degerler dashboard environment variable olarak verilir.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
